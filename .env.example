# Admin secret route (change this to something unpredictable)
# JANGAN pakai contoh ini di production - buat string acak sendiri
ADMIN_SECRET=ganti-dengan-path-rahasia-sendiri

# Admin credentials
# PENTING: setiap karakter $ di hash WAJIB ditulis \$ karena Next.js meng-expand
# $ sebagai variabel env. Contoh: hash "$2a$12$abc" ditulis "\$2a\$12\$abc"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=\$2a\$12\$YOUR_BCRYPT_HASH_HERE

# JWT secret for session tokens (generate a random string)
JWT_SECRET=change-this-to-a-random-64-char-string

# Store info
STORE_NAME=RFMstore
STORE_TAGLINE=Aplikasi Premium Termurah & Terpercaya

# WhatsApp & group links
NEXT_PUBLIC_WA_NUMBER=6281234567890
NEXT_PUBLIC_WA_MESSAGE=Halo admin, saya mau tanya soal akun premium
NEXT_PUBLIC_WA_GROUP=https://chat.whatsapp.com/your-group-invite-code
NEXT_PUBLIC_WA_CHANNEL=https://whatsapp.com/channel/your-channel-id

# Logo.dev API key (https://logo.dev) for real app logos
NEXT_PUBLIC_LOGO_DEV_API_KEY=isi_token_disini
